apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: cilium
  namespace: kube-system
spec:
  repo: https://helm.cilium.io
  chart: cilium
  version: "{{ cilium_version }}"
  targetNamespace: kube-system
  bootstrap: true
  valuesContent: |-
    k8sServiceHost: {{ rke2_master_ipv4 }}
    k8sServicePort: 6443
    ipam:
      mode: "cluster-pool"
      operator:
        clusterPoolIPv4PodCIDRList: ["{{ cluster_cidr_ipv4 }}"]
    kubeProxyReplacement: true
    ipv4NativeRoutingCIDR: "{{ native_routing_cidr_ipv4 }}"
    cni:
      chainingMode: "none"
    bpf:
      masquerade: true
      lbExternalClusterIP: true
    rollOutCiliumPods: true
    operator:
      replicas: {{ cilium_operator_replicas }}
      rollOutPods: true
    l2announcements:
      enabled: true
    k8sClientRateLimit:
      qps: 10
      burst: 20
    cluster:
      name: {{ cilium_cluster_name }}
      id: {{ cilium_cluster_id }}
    clustermesh:
      enableEndpointSliceSynchronization: true
      useAPIServer: true
      config:
        enabled: true
        clusters:
{% for peer in cilium_cluster_mesh_peers %}
        - name: {{ peer.name }}
          address: {{ peer.address }}
          port: {{ peer.port | default(2379) }}
{% endfor %}
      apiserver:
        service:
          type: LoadBalancer
          annotations:
            lbipam.cilium.io/ips: "{{ cilium_cluster_mesh_ip }}"
          labels:
            lb-pool: tailnet
        tls:
          auto:
            enabled: true
            method: certmanager
            certValidityDuration: 365
            certManagerIssuerRef:
              group: cert-manager.io
              kind: Issuer
              name: cilium-mesh-ca
{% if cilium_hubble_enabled %}
    hubble:
      enabled: true
      relay:
        enabled: true
      tls:
        auto:
          enabled: true
          method: certmanager
          certValidityDuration: 365
          certManagerIssuerRef:
            group: cert-manager.io
            kind: Issuer
            name: cilium-mesh-ca
      ui:
        enabled: true
        ingress:
          enabled: false
{% endif %}
